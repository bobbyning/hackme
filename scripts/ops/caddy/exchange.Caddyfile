{
	email admin@hackme.tech
	servers {
		protocols h1 h2
	}
}

(exchange_site) {
	encode gzip
	# Same-origin oracle/hub proxies — browser CSP connect-src self (no CORS on hub)
	handle_path /pool-proxy/* {
		rewrite * /pool/coordinator{path}
		reverse_proxy https://hackme.tech {
			header_up Host hackme.tech
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}
	handle_path /hub-proxy/* {
		rewrite * {path}
		reverse_proxy https://hackme.tech {
			header_up Host hackme.tech
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	# Never expose matching API on public edge
	respond /api/* 404
	respond /lab/* 404
	respond /admin/* 404
	respond /health 404
	respond /openapi.yaml 404

	handle {
		root * /var/www/exchange
		try_files {path} /index.html
		file_server
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
			X-Content-Type-Options nosniff
			# Hub iframe: allow hackme.tech + local dashboard; never X-Frame-Options SAMEORIGIN
			Content-Security-Policy "default-src 'self'; script-src 'self' blob: https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://hackme.tech; connect-src 'self' https://hackme.tech https://api.binance.com https://cloudflareinsights.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self' https://hackme.tech http://127.0.0.1:8080 http://localhost:8080"
			Referrer-Policy strict-origin-when-cross-origin
			Permissions-Policy "geolocation=(), microphone=(), camera=()"
			Cross-Origin-Opener-Policy same-origin
			Cross-Origin-Resource-Policy cross-origin
			-X-Frame-Options
			-Server
		}
		@assets {
			path /assets/*
			not path /assets/boot-*
		}
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@boot_assets path /assets/boot-* /index.html
		header @boot_assets Cache-Control "no-cache"
	}
}

http://89.150.41.40, :80 {
	import exchange_site
}

exchange.hackme.tech {
	import exchange_site
}

:88, :8444 {
	respond "gone" 410
}
